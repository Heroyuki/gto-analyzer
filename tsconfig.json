{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "infra/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "legacy"
  ]
}
